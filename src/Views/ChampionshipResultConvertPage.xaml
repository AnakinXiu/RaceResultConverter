<UserControl x:Class="RaceResultConverter.ChampionshipResultConvertPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RaceResultConverter"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:ChampionshipResultConvertViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="TextBlock" BasedOn="{StaticResource General.TextBlock}"/>
            <Style TargetType="TextBox" BasedOn="{StaticResource General.TextBox}"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="General.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Result Folder"/>
        <TextBox Grid.Row="0" Grid.Column="1"
                   Text="{Binding ChampionshipFolderPath}"/>
        <Button Grid.Row="0" Grid.Column="2" 
                Content="{x:Static local:Resource.btnSelectFolder}"
                Command="{Binding Path=SelectFolderCommand }"
                Style="{StaticResource General.Button}"/>

        <DataGrid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3"
                  ItemsSource="{Binding ZRoundRaceResultItems}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  >
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Width="40"/>
                <DataGridTextColumn Header="rcf File" Width="*"/>
                <DataGridTextColumn Header="json File" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Column="0" Grid.Row="2" 
                Content="{x:Static local:Resource.btnConvert}"
                Command="{Binding Path=ConvertCommand }"
                Style="{StaticResource General.Button}"/>
    </Grid>
</UserControl>
